// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum Direction {
  ltr
  rtl
}

enum UnitType {
  WEIGHT
  VOLUME
  QUANTITY
}

model Language {
  id         Int       @id @default(autoincrement())
  code       String    @db.VarChar(10)
  locale     String    @unique @db.VarChar(10)
  nativeName String    @map("native_name") @db.VarChar(50)
  latinName  String    @map("latin_name") @db.VarChar(50)
  direction  Direction @default(ltr)
  isActive   Boolean   @default(true)
  fallback   String?   @db.VarChar(10)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users                  User[]                  @relation("UserLanguage")
  recipeTranslations     RecipeTranslation[]     @relation("RecipeTranslationLanguage")
  ingredientTranslations IngredientTranslation[] @relation("IngredientTranslationLanguage")
  unitTranslations       UnitTranslation[]       @relation("UnitTranslationLanguage")
  departmentTranslations DepartmentTranslation[] @relation("DepartmentTranslationLanguage")
  ustensilTranslations   UstensilTranslation[]   @relation("UstensilTranslationLanguage")
  tagTranslations        TagTranslation[]        @relation("TagTranslationLanguage")
  categoryTranslations   CategoryTranslation[]   @relation("CategoryTranslationLanguage")
  wineTranslations       WineTranslation[]       @relation("WineTranslationLanguage")
  reviews                Review[]                @relation("ReviewLanguage")

  @@map("languages")
  @@index([code])
  @@index([locale])
}

model User {
  id         String    @id @default(cuid())
  email      String    @unique
  username   String    @unique
  password   String
  language   Language? @relation("UserLanguage", fields: [languageId], references: [id])
  languageId Int?      @map("language_id")
  roles      Role[]    @default([USER])
  createdAt  DateTime  @default(now()) @map("created_at")

  recipes         Recipe[]                @relation("RecipeAuthor")
  reviews         Review[]                @relation("ReviewUser")
  userUstensils   UserUstensil[]          @relation("UserUstensil")
  userIngredients UserIngredient[]        @relation("UserIngredient")

  @@map("users")
  @@index([languageId])
  @@index([email])
  @@index([username])
}

model Recipe {
  id              Int       @id @default(autoincrement())
  slug            String    @unique
  images          String[]
  part            Int
  note            Float?
  preparationTime Int?      @map("preparation_time")
  cookingTime     Int?      @map("cooking_time")
  restTime        Int?      @map("rest_time")
  isPublished     Boolean   @default(true)
  createdAt       DateTime  @default(now()) @map("created_at")
  modifiedAt      DateTime? @map("modified_at")

  author   User   @relation("RecipeAuthor", fields: [authorId], references: [id])
  authorId String @map("author_id")

  wines        RecipeWine[]        @relation("RecipeWine")
  tags         RecipeTag[]         @relation("RecipeTag")
  ustensils    RecipeUstensil[]    @relation("RecipeUstensil")
  ingredients  RecipeIngredient[]  @relation("RecipeIngredient")
  reviews      Review[]             @relation("RecipeReview")
  translations RecipeTranslation[] @relation("RecipeTranslation")

  @@map("recipes")
  @@index([authorId])
  @@index([isPublished])
  @@index([slug])
  @@index([createdAt])
}

model RecipeTranslation {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  stage       String[]
  language    Language @relation("RecipeTranslationLanguage", fields: [languageId], references: [id])
  languageId  Int      @map("language_id")
  recipe      Recipe   @relation("RecipeTranslation", fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId    Int      @map("recipe_id")

  @@unique([recipeId, languageId])
  @@map("recipes_translations")
  @@index([recipeId])
  @@index([languageId])
}

model Ingredient {
  id            Int        @id @default(autoincrement())
  department    Department @relation(fields: [departmentId], references: [id])
  departmentId  Int        @map("department_id")
  density       Float?
  averageWeight Float?     @map("average_weight")

  recipes      RecipeIngredient[] @relation("RecipeIngredient")
  users        UserIngredient[]   @relation("UserIngredient")
  translations IngredientTranslation[] @relation("IngredientTranslation")
  units        IngredientUnit[]   @relation("IngredientUnit")

  @@map("ingredients")
  @@index([departmentId])
}

model IngredientTranslation {
  id           Int        @id @default(autoincrement())
  name         String
  language     Language   @relation("IngredientTranslationLanguage", fields: [languageId], references: [id])
  languageId   Int        @map("language_id")
  ingredient   Ingredient @relation("IngredientTranslation", fields: [ingredientId], references: [id], onDelete: Cascade)
  ingredientId Int        @map("ingredient_id")

  @@unique([ingredientId, languageId])
  @@map("ingredients_translations")
  @@index([ingredientId])
  @@index([languageId])
}

model Unit {
  id   Int      @id @default(autoincrement())
  type UnitType

  ingredients       IngredientUnit[]       @relation("IngredientUnit")
  recipeIngredients RecipeIngredient[]     @relation("RecipeIngredientUnit")
  userIngredients   UserIngredient[]       @relation("UserIngredientUnit")
  translations      UnitTranslation[]      @relation("UnitTranslation")
  conversionsFrom   ConversionUnit[]       @relation("Base")
  conversionsTo     ConversionUnit[]       @relation("Target")

  @@map("units")
  @@index([type])
}

model UnitTranslation {
  id         Int      @id @default(autoincrement())
  name       String
  language   Language @relation("UnitTranslationLanguage", fields: [languageId], references: [id])
  languageId Int      @map("language_id")
  unit       Unit     @relation("UnitTranslation", fields: [unitId], references: [id], onDelete: Cascade)
  unitId     Int      @map("unit_id")

  @@unique([unitId, languageId])
  @@map("units_translations")
  @@index([unitId])
  @@index([languageId])
}

model ConversionUnit {
  base     Unit @relation("Base", fields: [baseId], references: [id])
  baseId   Int  @map("base_id")
  target   Unit @relation("Target", fields: [targetId], references: [id])
  targetId Int  @map("target_id")
  factor   Float

  @@id([baseId, targetId])
  @@map("conversions_units")
  @@index([baseId])
  @@index([targetId])
}

model IngredientUnit {
  ingredient   Ingredient @relation("IngredientUnit", fields: [ingredientId], references: [id])
  ingredientId Int        @map("ingredient_id")
  unit         Unit       @relation("IngredientUnit", fields: [unitId], references: [id])
  unitId       Int        @map("unit_id")
  isDefault    Boolean    @default(false) @map("is_default")

  @@id([ingredientId, unitId])
  @@map("ingredients_units")
  @@index([ingredientId])
  @@index([unitId])
}

model Department {
  id           Int                     @id @default(autoincrement())
  ingredients  Ingredient[]
  translations DepartmentTranslation[] @relation("DepartmentTranslation")

  @@map("departments")
}

model DepartmentTranslation {
  id           Int        @id @default(autoincrement())
  name         String
  language     Language   @relation("DepartmentTranslationLanguage", fields: [languageId], references: [id])
  languageId   Int        @map("language_id")
  department   Department @relation("DepartmentTranslation", fields: [departmentId], references: [id], onDelete: Cascade)
  departmentId Int        @map("department_id")

  @@unique([departmentId, languageId])
  @@map("departments_translations")
  @@index([departmentId])
  @@index([languageId])
}

model Ustensil {
  id Int @id @default(autoincrement())

  recipes      RecipeUstensil[] @relation("RecipeUstensil")
  users        UserUstensil[]   @relation("UserUstensil")
  translations UstensilTranslation[] @relation("UstensilTranslation")

  @@map("ustensils")
}

model UstensilTranslation {
  id         Int      @id @default(autoincrement())
  name       String
  language   Language @relation("UstensilTranslationLanguage", fields: [languageId], references: [id])
  languageId Int      @map("language_id")
  ustensil   Ustensil @relation("UstensilTranslation", fields: [ustensilId], references: [id], onDelete: Cascade)
  ustensilId Int      @map("ustensil_id")

  @@unique([ustensilId, languageId])
  @@map("ustensils_translations")
  @@index([ustensilId])
  @@index([languageId])
}

model Tag {
  id         Int      @id @default(autoincrement())
  category   Category @relation(fields: [categoryId], references: [id])
  categoryId Int      @map("category_id")

  recipes      RecipeTag[] @relation("RecipeTag")
  translations TagTranslation[] @relation("TagTranslation")

  @@map("tags")
  @@index([categoryId])
}

model TagTranslation {
  id         Int      @id @default(autoincrement())
  name       String
  language   Language @relation("TagTranslationLanguage", fields: [languageId], references: [id])
  languageId Int      @map("language_id")
  tag        Tag      @relation("TagTranslation", fields: [tagId], references: [id], onDelete: Cascade)
  tagId      Int      @map("tag_id")

  @@unique([tagId, languageId])
  @@map("tags_translations")
  @@index([tagId])
  @@index([languageId])
}

model Category {
  id Int @id @default(autoincrement())

  tags         Tag[]
  translations CategoryTranslation[] @relation("CategoryTranslation")

  @@map("categories")
}

model CategoryTranslation {
  id         Int      @id @default(autoincrement())
  name       String
  language   Language @relation("CategoryTranslationLanguage", fields: [languageId], references: [id])
  languageId Int      @map("language_id")
  category   Category @relation("CategoryTranslation", fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId Int      @map("category_id")

  @@unique([categoryId, languageId])
  @@map("categories_translations")
  @@index([categoryId])
  @@index([languageId])
}

model Wine {
  id Int @id @default(autoincrement())

  recipes      RecipeWine[] @relation("RecipeWine")
  translations WineTranslation[] @relation("WineTranslation")

  @@map("wines")
}

model WineTranslation {
  id         Int      @id @default(autoincrement())
  name       String
  country    String?
  region     String?
  language   Language @relation("WineTranslationLanguage", fields: [languageId], references: [id])
  languageId Int      @map("language_id")
  wine       Wine     @relation("WineTranslation", fields: [wineId], references: [id], onDelete: Cascade)
  wineId     Int      @map("wine_id")

  @@unique([wineId, languageId])
  @@map("wines_translations")
  @@index([wineId])
  @@index([languageId])
}

model RecipeWine {
  recipe   Recipe @relation("RecipeWine", fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId Int    @map("recipe_id")
  wine     Wine   @relation("RecipeWine", fields: [wineId], references: [id])
  wineId   Int    @map("wine_id")

  @@id([recipeId, wineId])
  @@map("recipes_wines")
  @@index([recipeId])
  @@index([wineId])
}

model RecipeTag {
  recipe   Recipe @relation("RecipeTag", fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId Int    @map("recipe_id")
  tag      Tag    @relation("RecipeTag", fields: [tagId], references: [id])
  tagId    Int    @map("tag_id")

  @@id([recipeId, tagId])
  @@map("recipes_tags")
  @@index([recipeId])
  @@index([tagId])
}

model RecipeUstensil {
  recipe     Recipe   @relation("RecipeUstensil", fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId   Int      @map("recipe_id")
  ustensil   Ustensil @relation("RecipeUstensil", fields: [ustensilId], references: [id])
  ustensilId Int      @map("ustensil_id")

  @@id([recipeId, ustensilId])
  @@map("recipes_ustensils")
  @@index([recipeId])
  @@index([ustensilId])
}

model RecipeIngredient {
  recipe       Recipe     @relation("RecipeIngredient", fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId     Int        @map("recipe_id")
  ingredient   Ingredient @relation("RecipeIngredient", fields: [ingredientId], references: [id])
  ingredientId Int        @map("ingredient_id")
  unit         Unit       @relation("RecipeIngredientUnit", fields: [unitId], references: [id])
  unitId       Int        @map("unit_id")
  quantity     Float

  @@id([recipeId, ingredientId])
  @@map("recipes_ingredients")
  @@index([recipeId])
  @@index([ingredientId])
  @@index([unitId])
}

model Review {
  user       User     @relation("ReviewUser", fields: [userId], references: [id])
  userId     String   @map("user_id")
  recipe     Recipe   @relation("RecipeReview", fields: [recipeId], references: [id])
  recipeId   Int      @map("recipe_id")
  language   Language @relation("ReviewLanguage", fields: [languageId], references: [id])
  languageId Int      @map("language_id")

  note        Float
  description String
  createdAt   DateTime  @default(now()) @map("created_at")
  modifiedAt  DateTime? @map("modified_at")

  @@id([userId, recipeId])
  @@map("reviews")
  @@index([userId])
  @@index([recipeId])
  @@index([languageId])
}

model UserUstensil {
  user       User     @relation("UserUstensil", fields: [userId], references: [id])
  userId     String   @map("user_id")
  ustensil   Ustensil @relation("UserUstensil", fields: [ustensilId], references: [id])
  ustensilId Int      @map("ustensil_id")

  @@id([userId, ustensilId])
  @@map("users_ustensils")
  @@index([userId])
  @@index([ustensilId])
}

model UserIngredient {
  user         User       @relation("UserIngredient", fields: [userId], references: [id])
  userId       String     @map("user_id")
  ingredient   Ingredient @relation("UserIngredient", fields: [ingredientId], references: [id])
  ingredientId Int        @map("ingredient_id")
  unit         Unit       @relation("UserIngredientUnit", fields: [unitId], references: [id])
  unitId       Int        @map("unit_id")
  quantity     Float

  @@id([userId, ingredientId])
  @@map("users_ingredients")
  @@index([userId])
  @@index([ingredientId])
  @@index([unitId])
}